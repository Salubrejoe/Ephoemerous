    "After his death the Muses set his lyre among the stars as Lyra; the swan Cygnus sails the Milky Way close by." : {
      "extractionState" : "manual",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dopo la sua morte le Muse pongono la sua lira tra le stelle come la Lira; il cigno Cygnus naviga la Via Lattea lì accanto."
          }
        }
      }
    },
