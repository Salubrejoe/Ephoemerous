    "Apollo gives Orpheus a lyre. He plays so beautifully that trees lean toward him and rivers slow to listen." : {
      "extractionState" : "manual",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Apollo dona a Orfeo una lira. Suona così divinamente che gli alberi si piegano verso di lui e i fiumi rallentano per ascoltare."
          }
        }
      }
    },
