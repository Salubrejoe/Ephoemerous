      "extractionState" : "manual",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Come un toro bianco come la neve, Zeus porta la principessa fenicia Europa oltre il mare fino a Creta, dove gli dà Minosse."
