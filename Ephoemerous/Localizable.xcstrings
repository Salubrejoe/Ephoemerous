      }
    },
    "The ram Chrysomallos — fleece of pure gold — carries the children Phrixus and Helle out of Boeotia and is sacrificed in Colchis." : {
      "extractionState" : "manual",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "L'ariete Crisomallo — dal vello d'oro puro — porta i fanciulli Frisso ed Elle fuori dalla Beozia ed è sacrificato in Colchide."
          }
        }
      }
    },
